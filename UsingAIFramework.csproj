<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- BaseVersion holds the pre-AI Program.cs for comparison; two Mains can't coexist.
         src/ holds sub-projects (Domain), labs/ holds the codealong labs — all excluded
         from the root app's default compile glob. -->
    <Compile Remove="BaseVersion\**" />
    <Compile Remove="src\**" />
    <Compile Remove="labs\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="src\Domain\Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- In use today: Azure OpenAI as the IChatClient provider, the Agents.AI agent layer,
         Extensions.AI for the abstraction + middleware, Configuration(.Json) for
         appsettings, and the Azure Monitor exporter for the OpenTelemetry traces. -->
    <PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.8.3" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.13.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.8.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />

    <!-- Not used by the demo yet. Kept on purpose: labs/README.md commits these two as
         Lab 1's point, that Ollama and Claude implement the same IChatClient the Azure
         provider does. Move them to the lab project once it exists. -->
    <PackageReference Include="Anthropic" Version="12.36.0" />
    <PackageReference Include="OllamaSharp" Version="5.4.27" />
  </ItemGroup>

</Project>
